# --- OpenRouter (vision captioning + fallback classifier) ---
# Reuse the key already exported in ~/.zshrc:
#   export OPENROUTER_API_KEY=$OPENROUTER_KEY_PERSONAL
OPENROUTER_API_KEY=
# Cheap vision model. gemini-2.5-flash-lite ≈ $0.10/MTok in / $0.40/MTok out.
# Free alternative: meta-llama/llama-3.2-11b-vision-instruct:free (rate-limited)
VISION_MODEL=google/gemini-2.5-flash-lite
# Text model for the fallback classifier (used only until JEV access lands)
TEXT_MODEL=google/gemini-2.5-flash-lite

# --- Ingestion ---
# Self-hosted or public RSSHub instance (option C). Leave blank to use Apify only.
RSSHUB_URL=
# https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# --- JEV (TypeSafe AI) — waitlist requested 2026-12-04, NOT on OpenRouter ---
# Leave blank to use the LLM fallback classifier.
JEV_API_URL=
JEV_API_KEY=

# --- Delivery to Slack ---
# Zapier "Catch Hook" webhook URL (recommended: keeps Slack routing flexible).
# Create in Zapier: Trigger "Catch Hook" -> copy the custom webhook URL here.
ZAPIER_CATCH_URL=
# $0 alternative if you skip Zapier: Slack incoming webhook
SLACK_WEBHOOK_URL=

# --- Site reports (crowd leg) — the ground-truth producer.
# pizzabase API base (the API that fronts the reports table). Wire a service
# token in pizzabase for machine auth; unset = crowd leg skipped.
PIZZABASE_API_URL=
PIZZABASE_API_KEY=
SITE_REPORTS_MAX=50

# --- Ops ---
# Copy config/feeds.example.json to config/feeds.json and edit.
FEEDS_CONFIG=./config/feeds.json
DATA_DIR=./data
# Only flag posts whose classifier confidence >= this (JEV confidence is calibrated)
FLAG_CONFIDENCE=0.7
# Hard cap per run — budget guard
MAX_POSTS_PER_RUN=40
# How many posts to caption in parallel
DESCRIBE_CONCURRENCY=3