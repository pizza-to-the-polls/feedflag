# Copy to .env and fill in. Keys with values below that live in GH repo
# secrets are marked [secret] — everything else is plain config.

# --- OpenRouter (vision captioning + fallback classifier + Jev transport) ---
OPENROUTER_API_KEY=          # [secret]
# Vision captioner: gemini-2.5-flash-lite ≈ $0.10/MTok in / $0.40/MTok out.
VISION_MODEL=google/gemini-2.5-flash-lite
# Text model for the fallback classifier (and wait-time normalization)
TEXT_MODEL=google/gemini-2.5-flash-lite

# --- JEV classifier (TypeSafe System One Model) — VIA OPENROUTER ---
# Model slug: typesafe/jev-router ($0.042/MTok in, output free).
# Uses OPENROUTER_API_KEY above. Set JEV_MODEL="" (empty) to pin the
# pipeline to the LLM fallback instead.
JEV_MODEL=typesafe/jev-router

# --- Ingestion ---
APIFY_API_TOKEN=             # [secret] https://console.apify.com/settings/integrations
# Optional RSSHub instance (X fallback). Unset = Apify-only.
RSSHUB_URL=

# --- pizzabase (crowd leg — ground-truth reports) ---
# GET /reports is public read; the machine token (api_keys row) covers
# authed endpoints and gives the key an auditable identity.
# Upsert SQL lives in data/machine-token.sql (gitignored — contains the key).
PIZZABASE_API_URL=https://base.polls.pizza
PIZZABASE_API_KEY=           # [secret] the machine token
SITE_REPORTS_MAX=50

# --- Delivery to Slack ---
# Zapier catch hook — interim: the pizzabase STAGING test hook
# (ZAP_NEW_REPORT in ~/Projects/pizzabase/.env, a local 127.0.0.1 sink).
# Swap for a real Zapier catch-hook URL when the Zap exists.
ZAPIER_CATCH_URL=            # [secret]
# $0 alternative / fallback notifier: Slack incoming webhook
SLACK_WEBHOOK_URL=            # [secret] — VETTING channel (noisier: churn + unverified sources)
# VOLUNTEER channel — only graduated sources' >= 60-min lines. Unset = single-channel
# mode (graduated lines post to SLACK_WEBHOOK_URL).
SLACK_VOLS_WEBHOOK_URL=      # [secret]
# Bot token (app: feedflag, A0CC6PZKUTS) — 👍/👎 on flag posts become labels
SLACK_BOT_TOKEN=             # [secret] — xoxb-... (OAuth & Permissions page)

# --- Govt wait-time extraction (Phase 3 pilot) ---
# Seeded sources (TX/NC discovery pilot). Plain-fetch + LLM text extraction;
# JS-walled sources fall back to screenshot+vision.
WAIT_TIME_SOURCES=./config/govt-sources.jsonl

# --- Ops ---
FEEDS_CONFIG=./config/feeds.json   # copy from config/feeds.example.json
DATA_DIR=./data
# Only flag posts whose classifier confidence >= this (Jev confidence is calibrated)
FLAG_CONFIDENCE=0.7
# Hard cap per run — budget guard
MAX_POSTS_PER_RUN=40
# How many posts to caption in parallel
DESCRIBE_CONCURRENCY=3

# --- Bastion digest timer (issue #31 → #67) ---
# The daily findings digest posts a comment on the findings issue from the
# bastion systemd timer. It needs NO credential here: it mints a 1h,
# repo-scoped issues:write installation token at run time via pizza-eagle's
# broker (`gh-token.mjs --repo … --purpose feedflag-digest`, pizza-eagle#45),
# which fetches the App PEM from Secrets Manager per call. So there is no PAT
# to store, rotate, or revoke — and nothing to add to ptp/prod/feedflag/env.
# GH_APP_ID is read from /etc/pizza-eagle/.env, not duplicated here.
FINDINGS_ISSUE=5             # findings issue number the digest comments on
FEEDFLAG_REPO_SLUG=pizza-to-the-polls/feedflag